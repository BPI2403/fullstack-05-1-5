"""Пример настроек окружения без секретов.

Скопируйте этот файл в ``.env`` и задайте реальные значения:
    cp .env.example .env
"""

# Приложение
APP_NAME=Личный финучёт API
APP_VERSION=0.1.0
DEBUG=True

# База данных PostgreSQL
# Формат: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finance

# CORS (разрешённые источники, через запятую)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000