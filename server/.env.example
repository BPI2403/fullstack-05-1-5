# Пример настроек окружения без секретов.
# Скопируйте этот файл в .env и задайте реальные значения: cp .env.example .env

# Приложение
APP_NAME=Личный финучёт API
APP_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# База данных PostgreSQL
# Формат: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finance

# Автосоздание таблиц при старте (True — dev/демо; в production используйте Alembic)
DB_AUTO_CREATE=True

# CORS (разрешённые источники, через запятую)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Аутентификация (JWT)
# Значение по умолчанию — только для разработки; задайте свой секрет в .env
JWT_SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
